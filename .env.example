# ASTHEN BOT - modelo de configuracao. Nunca publique seu arquivo .env.
# Crie uma aplicacao e um bot em https://discord.com/developers/applications

DISCORD_TOKEN=COLOQUE_SEU_TOKEN_AQUI
CLIENT_ID=COLOQUE_O_APPLICATION_ID_AQUI

# Opcional: ID do servidor de teste para registrar slash commands imediatamente.
# Deixe vazio para registrar os comandos globalmente.
GUILD_ID=
